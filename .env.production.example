# Копирайте в игнорирания .env. Попълнете локално чрез защитен редактор.
# Няма използваеми credentials. Не публикувайте .env или compose config output.
POSTGRES_PASSWORD=
# postgresql+psycopg://assetcore:<URL-encoded password>@db:5432/assetcore
DATABASE_URL=
SECRET_KEY=
OWNER_FIRST_NAME=
OWNER_MIDDLE_NAME=
OWNER_LAST_NAME=
OWNER_EMAIL=
OWNER_JOB_TITLE=
# Само първоначален bootstrap; премахнете след forced password change.
OWNER_INITIAL_PASSWORD=
INSTALLATION_ID=
# Само Ed25519 PUBLIC key; issuer private key никога не влиза в инсталацията.
LICENSE_PUBLIC_KEY=
LICENSE_ENFORCEMENT_ENABLED=true
DEPLOYMENT_ENVIRONMENT=production
PRODUCTION_MODE=true
PUBLIC_BASE_URL=
FRONTEND_ORIGIN=
SIGNATURE_ENCRYPTION_KEY=
MIGRATION_STRATEGY=external
MIGRATION_LOCK_TIMEOUT_SECONDS=60
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=0
SESSION_MINUTES=720
SESSION_COOKIE_SAMESITE=lax
BEARER_COMPATIBILITY_ENABLED=false
TRUSTED_PROXY_IPS=
# Uvicorn scheme/header trust; задайте само реално проверения непосредствен proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
ASSETCORE_BIND_ADDRESS=127.0.0.1
ASSETCORE_PORT=10000
# Production helper pin-ва проверен immutable image ID. Няма production default tag.
ASSETCORE_IMAGE=
# BACKUP_ENCRYPTION_KEY НЕ се задава тук: само временна operational shell secret.
